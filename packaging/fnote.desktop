[Desktop Entry]
Type=Application
Name=FNote
GenericName=Notes manuscrites
Comment=Prendre des notes et annoter des PDF au stylet, 100 % hors ligne
Exec=@EXEC@ %f
Icon=fnote
Terminal=false
Categories=Office;
Keywords=notes;stylet;manuscrit;PDF;annoter;surligneur;Obsidian;
MimeType=application/x-fnote;application/pdf;
StartupWMClass=fnote
StartupNotify=true
