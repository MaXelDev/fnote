#!/bin/sh
# FNote : on ne committe jamais du code cassé (tests + garde-fou hors ligne).
# Contourner exceptionnellement : git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
PY=.venv/bin/python
[ -x "$PY" ] || PY=python3
if ! "$PY" -m pytest -q >/tmp/fnote-precommit.log 2>&1; then
    tail -25 /tmp/fnote-precommit.log
    echo "pre-commit : les tests échouent, commit annulé."
    exit 1
fi
